{
  "meta": {
    "system": "n3_ten_point_mastery",
    "version": "1.0.0",
    "defaultTheme": "light",
    "themes": {
      "light": "Academic Editorial Light",
      "dark": "Nordic Frost Matte Dark"
    }
  },
  "themes": {
    "light": {
      "bgBase": "#FAFAF9",
      "bgSurface": "#FFFFFF",
      "bgCanvas": "#F4F4F5",
      "bgElevated": "#FFFFFF",
      "bgHover": "#EFEFEF",
      "textPrimary": "#18181B",
      "textSecondary": "#3F3F46",
      "textMuted": "#52525B",
      "borderSubtle": "#E4E4E7",
      "borderStrong": "#D4D4D8",
      "accentPrimary": "#1D4ED8",
      "accentHover": "#1E40AF",
      "accentSoft": "#EFF6FF",
      "accentContrast": "#FFFFFF",
      "statusSuccess": "#15803D",
      "statusSuccessSoft": "#F0FDF4",
      "statusWarning": "#B45309",
      "statusWarningSoft": "#FFFBEB",
      "statusDanger": "#B91C1C",
      "statusDangerSoft": "#FEF2F2",
      "rubyColor": "#52525B",
      "maskBg": "#F4F4F5",
      "maskBorder": "#1D4ED8"
    },
    "dark": {
      "bgBase": "#1E1E24",
      "bgSurface": "#16161A",
      "bgCanvas": "#121214",
      "bgElevated": "#26262E",
      "bgHover": "#2B2B34",
      "textPrimary": "#F4F4F6",
      "textSecondary": "#E2E8F0",
      "textMuted": "#94A3B8",
      "borderSubtle": "#2E2E38",
      "borderStrong": "#3F3F4C",
      "accentPrimary": "#38BDF8",
      "accentHover": "#7DD3FC",
      "accentSoft": "#132938",
      "accentContrast": "#0F172A",
      "statusSuccess": "#4ADE80",
      "statusSuccessSoft": "#132A1C",
      "statusWarning": "#FBBF24",
      "statusWarningSoft": "#2D220F",
      "statusDanger": "#F87171",
      "statusDangerSoft": "#321618",
      "rubyColor": "#94A3B8",
      "maskBg": "#26262E",
      "maskBorder": "#38BDF8"
    }
  },
  "typography": {
    "fontSans": "'Noto Sans JP', 'Hiragino Sans', 'Yu Gothic UI', Inter, 'Segoe UI', Roboto, sans-serif",
    "fontMono": "'JetBrains Mono', Consolas, 'Courier New', monospace",
    "readingMeasure": "65ch",
    "readingMaxMeasure": "75ch",
    "lineHeightBody": 1.65,
    "lineHeightJp": 1.95
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px"
  },
  "borders": {
    "hairline": "1px solid var(--border-subtle)"
  }
}
